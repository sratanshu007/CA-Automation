# Sab optional hai. Is file ko .env naam se copy karein.

# Login password (office network pe chalao to zaroor lagao). Khaali = login nahi.
APP_PASSWORD=
APP_USER=admin

# AI jawab ka source: gemini | claude | ollama | off
#   gemini = Google Gemini (online, tez aur Hindi/Hinglish ke liye behtar)
#   claude = Anthropic Claude (online)
#   ollama = POORA OFFLINE (local model, README mein setup)
#   off    = AI band, sirf keyword search + citations
LLM_PROVIDER=gemini

# Google Gemini ke liye (Google AI Studio: https://aistudio.google.com)
# Yahan apni Gemini API key paste karein:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Claude ke liye (sirf LLM_PROVIDER=claude ya key hone par)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama ke liye (sirf LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434

# Server
HOST=127.0.0.1
PORT=5001
